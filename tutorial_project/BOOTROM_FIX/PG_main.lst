#[1]   PG_main.asm
#[2]   macro.h
   48                             .INCLUDE        "macro.h"
    1                     ;******************************************************************************
    2                     ;       MOVE関係
    3                     ;******************************************************************************
    4                     LD_W MACRO
    5                             lda  \2
    6                             sta  \1
    7                             lda  \2+1
    8                             sta  \1+1
    9                             ENDM
   10                     
   11                     ;******************************************************************************
   12                     ;       算術関係
   13                     ;******************************************************************************
   14                     
   15                     ADD_W MACRO
   16                             clc
   17                             lda  \1
   18                             adc  \2
   19                             sta  \1
   20                             lda  \1+1
   21                             adc  \2+1
   22                             sta  \1+1
   23                             ENDM
   24                     
   25                     ;------------------------------------------------------------------------------
   26                     ;                               バイト足し演算
   27                     ;------------------------------------------------------------------------------
   28                     add     MACRO
   29                             clc
   30                             adc     \1
   31                             ENDM
   32                     ;------------------------------------------------------------------------------
   33                     ;                               バイト引き演算
   34                     ;------------------------------------------------------------------------------
   35                     sub     MACRO
   36                             sec
   37                             sbc     \1
   38                             ENDM
   39                     ;------------------------------------------------------------------------------
   40                     ;                               ワード足し演算
   41                     ;                               xy + \1\2 = xy
   42                     ;------------------------------------------------------------------------------
   43                     addw    MACRO
   44                             pha
   45                     
   46                             tya
   47                             add     \2
   48                             tay
   49                             bne     .byte_over\@
   50                             bcc     .byte_over\@
   51                     
   52                             sec
   53                     .byte_over\@:
   54                             txa
   55                             adc     \1
   56                             tax
   57                     
   58                             pla
   59                             ENDM
   60                     ;------------------------------------------------------------------------------
   61                     ;                               ワード引き演算
   62                     ;                               xy - \1\2 = xy
   63                     ;------------------------------------------------------------------------------
   64                     subw    MACRO
   65                             pha
   66                     
   67                             tya
   68                             sub     \2
   69                             tay
   70                     
   71                             txa
   72                             sbc     \1
   73                             tax
   74                     
   75                             pla
   76                             ENDM
   77                     
   78                     ;------------------------------------------------------------------------------
   79                     ;                               ワードインクリメント
   80                     ;                               \1\2 + 1 = \1\2
   81                     ;------------------------------------------------------------------------------
   82                     incw    MACRO
   83                             inc     \1
   84                             bne     .iend\@
   85                     
   86                             inc     \1 + 1
   87                     .iend\@:
   88                     
   89                             ENDM
   90                     
   91                     ;------------------------------------------------------------------------------
   92                     ;                               ワードデクリメント
   93                     ;                               \1\2 - 1 = \1\2
   94                     ;------------------------------------------------------------------------------
   95                     decw    MACRO
   96                             lda     \1
   97                             bne     .dend\@
   98                     
   99                             dec     \1 + 1
  100                     .dend\@:
  101                             dec     \1
  102                     
  103                             ENDM
  104                     
  105                     ;------------------------------------------------------------------------------
  106                     ;               擬似ワードレジスタ　AR に固定ワードセット
  107                     ;------------------------------------------------------------------------------
  108                     SET_AR  MACRO
  109                             LDA     \1 & $ff
  110                             STA     <W_AR
  111                             LDA     \1 >> 8
  112                             STA     <W_AR+1
  113                             ENDM
  114                     
  115                     ;------------------------------------------------------------------------------
  116                     ;               擬似ワードレジスタ　BR に固定ワードセット
  117                     ;------------------------------------------------------------------------------
  118                     SET_BR  MACRO
  119                             LDA     \1 & $ff
  120                             STA     <W_BR
  121                             LDA     \1 >> 8
  122                             STA     <W_BR+1
  123                             ENDM
  124                     
  125                     ;------------------------------------------------------------------------------
  126                     ;               擬似ワードレジスタ　AR にメモリー上のワード値セット
  127                     ;------------------------------------------------------------------------------
  128                     SET_AR_M        MACRO
  129                             LDA     \1
  130                             STA     <W_AR
  131                             LDA     \1+1
  132                             STA     <W_AR+1
  133                             ENDM
  134                     
  135                     ;------------------------------------------------------------------------------
  136                     ;               擬似ワードレジスタ　BR にメモリー上のワード値セット
  137                     ;------------------------------------------------------------------------------
  138                     SET_BR_M        MACRO
  139                             LDA     \1
  140                             STA     <W_BR
  141                             LDA     \1+1
  142                             STA     <W_BR+1
  143                             ENDM
  144                     
  145                     ;------------------------------------------------------------------------------
  146                     ;                               対象のメモリーのビットをセットする
  147                     ;                               対象メモリーアドレス = \1
  148                     ;                               セットするビット     = \2
  149                     ;------------------------------------------------------------------------------
  150                     SET_BIT         MACRO
  151                             LDA     \1
  152                             ORA     \2
  153                             STA     \1
  154                             ENDM
  155                     
  156                     ;------------------------------------------------------------------------------
  157                     ;                               対象のメモリーのビットをクリアーする
  158                     ;                               対象メモリーアドレス = \1
  159                     ;                               クリアーするビット   = \2
  160                     ;------------------------------------------------------------------------------
  161                     CLR_BIT         MACRO
  162                             LDA     \1
  163                             AND     $ff - \2
  164                             STA     \1
  165                             ENDM
  166                     
  167                     ;------------------------------------------------------------------------------
  168                     ;                               対象のメモリーのビットをチェックする
  169                     ;                               対象メモリーアドレス = \1
  170                     ;                               チェックするビット   = \2
  171                     ;------------------------------------------------------------------------------
  172                     CHK_BIT         MACRO
  173                             LDA     \1
  174                             AND     \2
  175                             ENDM
  176                     
  177                     
  178                     ;------------------------------------------------------------------------------
  179                     ;                               XYレジスタをスタックに退避
  180                     ;------------------------------------------------------------------------------
  181                     phxy            MACRO
  182                             sta  <TMP_SYS
  183                             txa
  184                             pha
  185                             tya
  186                             pha
  187                             lda  <TMP_SYS
  188                             ENDM
  189                     
  190                     ;------------------------------------------------------------------------------
  191                     ;                               XYレジスタをスタックから復帰
  192                     ;------------------------------------------------------------------------------
  193                     plxy            MACRO
  194                             sta  <TMP_SYS
  195                             pla
  196                             tay
  197                             pla
  198                             tax
  199                             lda  <TMP_SYS
  200                             ENDM
  201                     
  202                     ;------------------------------------------------------------------------------
  203                     ;                               SRC_ADRをスタックに退避
  204                     ;------------------------------------------------------------------------------
  205                     phSRC_ADR       MACRO
  206                             lda  <SRC_ADR+0
  207                             pha
  208                             lda  <SRC_ADR+1
  209                             pha
  210                             ENDM
  211                     
  212                     ;------------------------------------------------------------------------------
  213                     ;                               XYレジスタをスタックから復帰
  214                     ;------------------------------------------------------------------------------
  215                     plSRC_ADR       MACRO
  216                             pla
  217                             sta  <SRC_ADR+1
  218                             pla
  219                             sta  <SRC_ADR+0
  220                             ENDM
  221                     
  222                     ;******************************************************************************
  223                     ;       表示関係
  224                     ;******************************************************************************
  225                     ;       画面切り替え時にＩＲＱ割り込みラインでのノイズを対処すべく、
  226                     ;       表示on、表示offは、マクロ化しました。→DISP_ON, DISP_OFF
  227                     ;       それに伴い、NMI_FLGの操作も併せて、こちらに移動しました。
  228                     ;                                                       渡部
  229                     ;------------------------------------------------------------------------------
  230                     ;                               表示on
  231                     ;------------------------------------------------------------------------------
  232                     DISP_ON         MACRO
  233                             jsr  _disp_on_sub
  234                             ENDM
  235                     
  236                     ;------------------------------------------------------------------------------
  237                     ;                               表示on NO SP
  238                     ;------------------------------------------------------------------------------
  239                     DISP_ON_NSP             MACRO
  240                             jsr  _disp_on_sub2
  241                             ENDM
  242                     
  243                     ;------------------------------------------------------------------------------
  244                     ;                               表示off
  245                     ;------------------------------------------------------------------------------
  246                     DISP_OFF        MACRO
  247                             jsr  _disp_off_sub
  248                             ENDM
  249                     
  250                     ;------------------------------------------------------------------------------
  251                     ;                               VRAMアドレスセット
  252                     ;                               VRAMアドレス = \1(16bit adr)
  253                     ;------------------------------------------------------------------------------
  254                     SET_VRAM_ADD2   MACRO
  255                             lda #HIGH (\1)
  256                         sta $2006
  257                             lda #LOW  (\1)
  258                             sta $2006
  259                             ENDM
  260                     
  261                     ;------------------------------------------------------------------------------
  262                     ;                               VRAMアドレスセット
  263                     ;                               VRAMアドレス = \1(16bit adr)
  264                     ;                               加算値 = \2
  265                     ;------------------------------------------------------------------------------
  266                     SET_VRAM_ADD3   MACRO
  267                             clc
  268                             lda #LOW  (\1)
  269                             adc  \2
  270                             pha
  271                             lda #HIGH (\1)
  272                             adc #0
  273                         sta $2006
  274                             pla
  275                             sta $2006
  276                             ENDM
  277                     
  278                     ;------------------------------------------------------------------------------
  279                     ;                               VRAMアドレスセット
  280                     ;                               VRAMアドレス = \1(16bit adr)
  281                     ;                               加算値 = \2
  282                     ;------------------------------------------------------------------------------
  283                     SET_VRAM_ADD4   MACRO
  284                             clc
  285                             lda #LOW  (\1)
  286                             adc  \2
  287                             pha
  288                             lda #HIGH (\1)
  289                             adc \2 +1
  290                         sta $2006
  291                             pla
  292                             sta $2006
  293                             ENDM
  294                     
  295                     ;------------------------------------------------------------------------------
  296                     ;                               VRAMアドレスセット
  297                     ;                               VRAMアドレス = \1(16bit adr)
  298                     ;------------------------------------------------------------------------------
  299                     SET_VRAM_LOC    MACRO
  300                             lda #HIGH (\1)
  301                         sta <TMP_ADR0+1
  302                             lda #LOW  (\1)
  303                         sta <TMP_ADR0+0
  304                             ENDM
  305                     
  306                     SET_VRAM_LOC_ADD        MACRO
  307                         lda <TMP_ADR0+1
  308                         sta $2006
  309                         lda <TMP_ADR0+0
  310                         sta $2006
  311                             ENDM
  312                     
  313                     ADD_VRAM_LOC_CR MACRO
  314                             clc
  315                             lda  <TMP_ADR0+0
  316                             adc  #32
  317                             sta  <TMP_ADR0+0
  318                             lda  <TMP_ADR0+1
  319                             adc  #0
  320                             sta  <TMP_ADR0+0
  321                             ENDM
  322                     
  323                     
  324                     ;------------------------------------------------------------------------------
  325                     ;                               VRAMアドレスセット
  326                     ;                               VRAMアドレス = \1(16bit adr)
  327                     ;------------------------------------------------------------------------------
  328                     SET_VRAM_ADD_A_00       MACRO
  329                             STA  $2006
  330                             LDA     #$00
  331                             STA  $2006
  332                             ENDM
  333                     
  334                     
  335                     
  336                     
  337                     ;------------------------------------------------------------------------------
  338                     ;                               データアドレスセット
  339                     ;                               データアドレス = \1 (16bit adr)
  340                     ;------------------------------------------------------------------------------
  341                     SET_DATA_SRC    MACRO
  342                             lda     #LOW (\1)
  343                             sta     <SRC_ADR
  344                             lda #HIGH (\1)
  345                         sta <SRC_ADR+1
  346                             ENDM
  347                     
  348                     ;------------------------------------------------------------------------------
  349                     ;                               データアドレスセット
  350                     ;                               データアドレス = \1 (16bit adr)
  351                     ;------------------------------------------------------------------------------
  352                     SET_DATA_DST    MACRO
  353                             lda     #LOW (\1)
  354                             sta     <DST_ADR
  355                             lda #HIGH (\1)
  356                         sta <DST_ADR +1
  357                             ENDM
  358                     
  359                     
  360                     ;------------------------------------------------------------------------------
  361                     ;                               データアドレスセット
  362                     ;                               データアドレス = \1 (16bit adr)
  363                     ;                               データアドレス = \2 (16bit adr)
  364                     ;------------------------------------------------------------------------------
  365                     SET_DATA_ADR    MACRO
  366                             lda     #LOW (\2)
  367                             sta     \1
  368                             lda #HIGH (\2)
  369                         sta \1+1
  370                             ENDM
  371                     
  372                     ;------------------------------------------------------------------------------
  373                     ;                               パレット転送
  374                     ;                               データアドレス = \1 (アドレス)
  375                     ;------------------------------------------------------------------------------
  376                     TRANS_PAL       MACRO
  377                             lda  #LOW (\1)
  378                             sta  <SRC_ADR
  379                             lda  #HIGH (\1)
  380                         sta  <SRC_ADR+1
  381                             jsr  SET_PAL_DATA
  382                             ENDM
  383                     
  384                     ;------------------------------------------------------------------------------
  385                     ;                               ネームテーブル＆パレット転送
  386                     ;                               データアドレス = \1 (バンク付アドレス)
  387                     ;------------------------------------------------------------------------------
  388                     DRAW_BG_DATA    MACRO
  389                             lda  #LOW (\1)
  390                             sta  <SRC_ADR
  391                             lda  #HIGH (\1)
  392                         sta  <SRC_ADR+1
  393                             ldx  #BANK (\1) /2
  394                             jsr  TRANS_NAME_PAL
  395                             ENDM
  396                     
  397                     ;------------------------------------------------------------------------------
  398                     ;                               ネームテーブル転送
  399                     ;                               データアドレス = \1 (バンク付アドレス)
  400                     ;------------------------------------------------------------------------------
  401                     DRAW_BG_DATA_NP MACRO
  402                             lda  #LOW (\1)
  403                             sta  <SRC_ADR
  404                             lda  #HIGH (\1)
  405                         sta  <SRC_ADR+1
  406                             ldx  #BANK (\1) /2
  407                             lda  <A0_BNK            ;
  408                             pha                     ;現行のバンクを保存
  409                             txa
  410                             jsr  CHG_A0_BANK
  411                             jsr  TRANS_NAMETBL_SUB
  412                     
  413                             pla
  414                             jsr  CHG_A0_BANK
  415                             ENDM
  416                     
  417                     
  418                     ;------------------------------------------------------------------------------
  419                     ;                               文字列描画
  420                     ;                               \1 = 文字列
  421                     ;------------------------------------------------------------------------------
  422                     DRAW_STRING2 MACRO
  423                             LDA  #HIGH (.end\@ -1)
  424                             PHA
  425                             LDA  #LOW (.end\@ -1)
  426                             PHA
  427                             LDA  #LOW (.tbl\@ )
  428                             STA  <SRC_ADR
  429                             LDA  #HIGH (.tbl\@ )
  430                             jmp  DRAW_STRING_SUB
  431                     .tbl\@:
  432                         db  \1,0
  433                     .end\@:
  434                             ENDM
  435                     
  436                     ;------------------------------------------------------------------------------
  437                     ;                               文字列描画
  438                     ;                               データソースアドレス = \1 (16bit adr)
  439                     ;------------------------------------------------------------------------------
  440                     DRAW_STRING     MACRO
  441                             lda     #\1 & $ff
  442                             STA     <SRC_ADR
  443                             LDA     #\1 >> 8
  444                     ;;      STA     <SRC_ADR+1
  445                             JSR     DRAW_STRING_SUB
  446                             ENDM
  447                     
  448                     ;------------------------------------------------------------------------------
  449                     ;                               文字列描画（クリアー切り替え付き）
  450                     ;                               データソースアドレス = \1 (16bit adr)
  451                     ;------------------------------------------------------------------------------
  452                     DRAW_STRING_S   MACRO
  453                             lda     #\1 & $ff
  454                             STA     <SRC_ADR
  455                             LDA     #\1 >> 8
  456                     ;;      STA     <SRC_ADR+1
  457                             JSR     DRAW_STRING_S_SUB
  458                             ENDM
  459                     
  460                     ;------------------------------------------------------------------------------
  461                     ;                               文字列描画（テーブル選択型）
  462                     ;                               A reg = テーブル選択番号
  463                     ;                               テーブルデータアドレス = \1 (16bit adr)
  464                     ;------------------------------------------------------------------------------
  465                     DRAW_STRING_TBL_SEL     MACRO
  466                             ASL     A
  467                             TAX
  468                             LDA     \1,X
  469                             STA     <SRC_ADR
  470                             LDA     \1+1,X
  471                     ;;      STA     <SRC_ADR+1
  472                             JSR     DRAW_STRING_SUB
  473                             ENDM
  474                     
  475                     ;------------------------------------------------------------------------------
  476                     PAL_CHG MACRO
  477                             inc  <PAL_CHG_FG
  478                             ENDM
