  729                     ;-------------------------------------------------------------------------------
  730                     ; メモリー制御
  731                     ;-------------------------------------------------------------------------------
  732                     
  733                     ;   A reg クリアーデータ
  734                     ;   Y reg クリアーサイズ ( 0 は 256バイト )
  735                     ;       \1 = クリアーメモリーアドレス (16bit adr)
  736                     
  737                     CLEAR_MEM       macro
  738                     
  739                     .loop\@:
  740                             dey
  741                             sta   \1,Y
  742                             bne   .loop\@
  743                     
  744                                     endm
  745                     
  746                     
  747                     COPY_TBL        macro
  748                             ldx  #0
  749                     .loop\@:
  750                             lda  \1,x
  751                             sta  \2,x
  752                             inx
  753                             cpx  #\3
  754                             bne   .loop\@
  755                                     endm
  756                     
  757                     
  758                     ;       \1 = 転送元アドレス (BNK+16bit adr)
  759                     ;       \2 = 転送先アドレス (16bit adr)
  760                     ;       \3 = 転送サイズ (8bit)
  761                     
  762                     COPY_MEM        macro
  763                             lda  #LOW (\1)
  764                             sta  <SRC_ADR
  765                             lda  #HIGH (\1)
  766                         sta  <SRC_ADR+1
  767                     
  768                             lda  #LOW (\2)
  769                             sta  <DST_ADR
  770                             lda  #HIGH (\2)
  771                         sta  <DST_ADR+1
  772                     
  773                             ldy  #(\3)
  774                             jsr  memcpy
  775                     
  776                             endm
  777                     
  778                     ;       \1 = 転送元アドレス (BNK+16bit adr)
  779                     ;       \2 = 転送先アドレス (16bit adr)
  780                     ;       \3 = 転送サイズ (16bit)
  781                     
  782                     COPY_MEM16      macro
  783                             lda  #LOW (\1)
  784                             sta  <SRC_ADR
  785                             lda  #HIGH (\1)
  786                         sta  <SRC_ADR+1
  787                     
  788                             lda  #LOW (\2)
  789                             sta  <DST_ADR
  790                             lda  #HIGH (\2)
  791                         sta  <DST_ADR+1
  792                     
  793                             ldy  #LOW (\3)
  794                             ldx  #HIGH (\3)
  795                     
  796                             lda  #BANK (\1) /2
  797                     
  798                             jsr  memcpy_x
  799                     
  800                             endm
  801                     
  802                     
  803                     
  804                     ;-------------------------------------------------------------------------------
  805                     ; BEEP
  806                     ;-------------------------------------------------------------------------------
  807                     
  808                     BEEP    MACRO
  809                             lda #0
  810                             sta $4015
  811                     
  812                     ;       lda $4015               ; サウンドレジスタ
  813                     ;       ora #%00000001  ; 矩形波チャンネル１を有効にする
  814                             lda #%00000001  ; 矩形波チャンネル１を有効にする
  815                             sta $4015
  816                     
  817                             lda #%10111111  ; Duty比・長さ無効・減衰無効・減衰率
  818                             sta $4000       ; 矩形波チャンネル１制御レジスタ１
  819                     
  820                     ;       lda #%10101011  ; スイープ有効・変化率・方向・変化量
  821                     ;       lda #%00101011  ; スイープ有効・変化率・方向・変化量
  822                             lda #(\2)       ; スイープ有効・変化率・方向・変化量
  823                             sta $4001       ; 矩形波チャンネル１制御レジスタ２
  824                             
  825                             lda #LOW(\1)    ; 周波数(下位8ビット)
  826                             sta $4002       ; 矩形波チャンネル１周波数レジスタ１
  827                             lda #%11111000 +(HIGH(\1) &7)   ; 再生時間・周波数(上位3ビット)
  828                             sta $4003       ; 矩形波チャンネル１周波数レジスタ２
  829                     
  830                             ENDM
