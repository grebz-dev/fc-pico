   99  03:F06C  85 85             sta     <KEY_NEW                ; 3
  100  03:F06E  8D 16 40          sta      $4016                  ; 4
  101  03:F071  4A                lsr      a                      ; 2  =lda #0
  102  03:F072  8D 16 40          sta      $4016                  ; 4
  103  03:F075            .read_loop:
  104  03:F075  AD 16 40          lda      $4016                  ; 4x
  105  03:F078  29 03             and     #(%11<<0)               ; 2x
  106  03:F07A  C9 01             cmp     #(%01<<0)               ; 2x
  107  03:F07C  26 85             rol     <KEY_NEW                ; 5x
  108  03:F07E  90 F5             bcc     .read_loop              ; 3x
  109                                                             ;-1
  110  03:F080  A5 85             lda     <KEY_NEW                ; 3
  111  03:F082  EA                nop                             ; 2  調整用
  112  03:F083  60                rts                             ; 6  (153)
