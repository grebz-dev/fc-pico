  509                     
  510                     ;******************************************************************************
  511                     ;       テーブル関係
  512                     ;******************************************************************************
  513                     
  514                     ;------------------------------------------------------------------------------
  515                     ;                               テーブルジャンプ
  516                     ;                               A reg = ジャンプ先テーブル番号
  517                     ;------------------------------------------------------------------------------
  518                     TBL_JUMP        MACRO
  519                             ASL     A
  520                             stx  <TMP_SYS
  521                             TAX
  522                             LDA     .tbl\@+1,X
  523                             PHA
  524                             LDA     .tbl\@+0,X
  525                             ldx  <TMP_SYS
  526                             PHA
  527                             RTS
  528                     .tbl\@:
  529                             ENDM
  530                     
  531                     ;------------------------------------------------------------------------------
  532                     ;  テーブルジャンプ先　宣言用マクロ　スタックを使う場合ジャンプ先-1 をプッシュ
  533                     ;------------------------------------------------------------------------------
  534                     JPTBL   MACRO
  535                             DW      \1 -1
  536                             ENDM
  537                     
  538                     ;------------------------------------------------------------------------------
  539                     ;                               バンク付テーブルジャンプ
  540                     ;                               A reg = ジャンプ先テーブル番号
  541                     ;------------------------------------------------------------------------------
  542                     BNK_TBL_JUMP    MACRO
  543                             sta  <TMP_SYS
  544                             stx  <TMP_SYS2
  545                             asl a
  546                             clc
  547                             adc  <TMP_SYS
  548                             tax
  549                     
  550                             ; 各ミッションタイプに応じた初期化処理を呼び出し
  551                             lda  .tbl\@+1,x
  552                             pha
  553                             lda  .tbl\@+0,x
  554                             pha
  555                     
  556                             lda  .tbl\@+2,x         ;BANK
  557                             jsr  SYS_CHG_BANK
  558                             ldx  <TMP_SYS2
  559                             rts
  560                     .tbl\@:
  561                             ENDM
  562                     
  563                     ;------------------------------------------------------------------------------
  564                     ;  バンク付ジャンプ先テーブル
  565                     ;------------------------------------------------------------------------------
  566                     BNK_JPTBL2      MACRO
  567                             DW      (\1 -1)
  568                             DB  #BANK ( \1 ) / 2
  569                             ENDM
  570                     
  571                     
  572                     
  573                     ;------------------------------------------------------------------------------
  574                     ;  バンク付アドレステーブル
  575                     ;------------------------------------------------------------------------------
  576                     ;BNK_ADR        MACRO
  577                     ;       DW      \1
  578                     ;       DB  #BANK ( \1 ) /2
  579                     ;       ENDM
  580                     
  581                     
  582                     
  583                     
  584                     
  585                     ;------------------------------------------------------------------------------
  586                     ;  バンク間コール ※A000 に配置された他バンクのサブルーチンを呼び出す
  587                     ;                               コール先アドレス = \1 (16bit adr + bank)
  588                     ;------------------------------------------------------------------------------
  589                     ;BNK_CALL       MACRO
  590                     ;       jsr     BANK_CALL_SUB
  591                     ;       DW      (\1 -1)
  592                     ;       DB  #BANK ( \1 ) / 2
  593                     ;       ENDM
  594                     
  595                     BNK_CALL        MACRO
  596                             jsr     \1
  597                             ENDM
  598                     
  599                     
  600                     ;=================================================================
  601                     ;                               ジャンプベクターチェック付きCALL
  602                     ;=================================================================
  603                     JVC_CALL MACRO
  604                             lda  \1
  605                             cmp  #$4C
  606                             bne  .iend\@
  607                             jsr  \1
  608                     .iend\@:
  609                             ENDM
  610                     
  611                     ;=================================================================
  612                     ;                               ジャンプベクターチェック付きJMP Areg 破壊
  613                     ;=================================================================
  614                     JVC_JMP MACRO
  615                             lda  \1
  616                             cmp  #$4C
  617                             bne     .iend\@
  618                             jmp  \1
  619                     .iend\@:
  620                             ENDM
  621                     
  622                     
  623                     ;=================================================================
  624                     ;                               ジャンプベクターチェック付きJMP Xreg 破壊
  625                     ;=================================================================
  626                     JVC_JMPX MACRO
  627                             ldx  \1
  628                             cpx  #$4C
  629                             bne     .iend\@
  630                             jmp  \1
  631                     .iend\@:
  632                             ENDM
  633                     
  634                     
  635                     ;=================================================================
  636                     ;                               空のジャンプベクター
  637                     ;=================================================================
  638                     DMY_JVC_JMP MACRO
  639                             db $FF,$FF,$FF
  640                             ENDM
  641                     
  642                     ;=================================================================
  643                     ;                               NMIユーザー処理登録用マクロ
  644                     ;=================================================================
  645                     SET_NMI_CALL    MACRO
  646                             LDA     #HIGH (\1)
  647                             STA <NMI_CALL_ADR+1
  648                             LDA     #LOW  (\1)
  649                             STA <NMI_CALL_ADR
  650                             LDA     #BANK (\1) /2
  651                             STA <NMI_CALL_BNK
  652                             ENDM
  653                     
  654                     
  655                     ;=================================================================
  656                     ;                               NMIユーザー処理解除用マクロ
  657                     ;=================================================================
  658                     CLR_NMI_CALL    MACRO
  659                             LDA     #0
  660                             STA <NMI_CALL_ADR+1
  661                             ENDM
  662                     
  663                     ;=================================================================
  664                     ;                               RAM転送システム用のマクロ
  665                     ;=================================================================
  666                     
  667                     ;------------------------------------------------------
  668                     ; VRAM転送先アドレス指定マクロ
  669                     ;------------------------------------------------------
  670                     SET_VRAMT_ADR   MACRO
  671                             lda   #HIGH (\1)
  672                             jsr   writeVRAMT_DATA
  673                             lda   #LOW  (\1)
  674                             jsr   writeVRAMT_DATA
  675                             ENDM
  676                     
  677                     
  678                     ;------------------------------------------------------------------------------
  679                     ;                               テーブル選択
  680                     ;                               A reg = テーブル選択番号
  681                     ;                               テーブルアドレス = \1 (16bit adr)
  682                     ;------------------------------------------------------------------------------
  683                     TBL_SELECT      MACRO
  684                             ASL     A
  685                             TAX
  686                             LDA     \1,X
  687                             STA     <SRC_ADR
  688                             LDA     \1+1,X
  689                             STA     <SRC_ADR+1
  690                             ENDM
  691                     
  692                     ;------------------------------------------------------------------------------
  693                     ;                               テーブル選択
  694                     ;                               A reg = テーブル選択番号
  695                     ;                               テーブルアドレス = \1 (16bit adr)
  696                     ;------------------------------------------------------------------------------
  697                     TBL_SELECT2     MACRO
  698                             ASL     A
  699                             TAX
  700                             LDA     \1,X
  701                             STA     <DST_ADR
  702                             LDA     \1+1,X
  703                             STA     <DST_ADR +1
  704                             ENDM
