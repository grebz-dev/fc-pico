  716                                     sta     <HIRQ_ENTRY_ADR+1
  717                                     endm
  718                     
  719                     
  720                     ; H-IRQ関数設定
  721                     HIRQ_FUNC_SET   macro
  722                                     lda     #LOW(\1)
  723                                     sta     <HIRQ_FUNC_ADR
