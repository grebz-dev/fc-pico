#[2]   SysEqu.h
   47                             .INCLUDE        "SysEqu.h"
    1                     ;========================================
    2                     ;
    3                     ; BOOTROM固定領域用ワーク
    4                     ;
    5                     ; ・キー入力関連以外は起動後は破壊してよい
    6                     ;
    7                     ; ・BOOTROM固定領域内のキー入力処理を使わずに
    8                     ;   別途キー入力チェック処理を用意する場合はすべて破壊しても良い
    9                     ; 
   10                     ;========================================
   11                     
   12           0000      W_AR            EQU     $00     ; 16 bit 計算用  2 bytes
   13           0002      W_BR            EQU     $02     ; 16 bit 計算用  2 bytes
   14                     
   15           0004      TMP_SVA         EQU     $04     ; 汎用 A レジスタ保存用アドレス
   16           0005      TMP_SVX         EQU     $05     ; 汎用 X レジスタ保存用アドレス
   17           0006      TMP_SVY         EQU     $06     ; 汎用 Y レジスタ保存用アドレス
   18           0007      TMP_LOOP_CNT    EQU     $07     ; 汎用ループカウンタ
   19                     
   20           0008      SRC_ADR         EQU     $08     ; 汎用ソースアドレス  2 bytes
   21           000A      DST_ADR         EQU     $0A     ; 汎用デスティネーションアドレス  2 bytes
   22                     
   23           000C      TMP_SYS         EQU     $0C             ;システムで使うTMP
   24           000D      TMP_SYS2        EQU     $0D             ;システムで使うTMP
   25                     
   26                     
   27                     ; 起動時RAMチェック
   28           0025      RAM_PAGE        EQU  $25
   29           0026      MEM_DISP        EQU  $26
   30                     
   31                     
   32           0051      PICO_MODE       EQU  $51                ; PICOの動作モード
   33                     
   34                     
   35                     ;----------------
   36                     ; キー関連
   37                     ;----------------
   38                     
   39           0082      KEY_REL         EQU     $82     ;
   40           0083      KEY_TRG         EQU     $83     ;
   41           0084      KEY_OLD         EQU     $84     ;
   42           0085      KEY_NEW         EQU     $85     ;
   43           000C      KEY_CH1         EQU     TMP_SYS
   44           000D      KEY_CH3         EQU     TMP_SYS2
   45                     
   46           008A      REP_KEY         EQU     $8A     ; リピート用のキー
   47           008B      REP_NEW         EQU     $8B     ; リピートによる押下状態
   48           008C      REP_CNT         EQU     $8C     ; ウェイト、インターバルのカウンタ
   49                     
   50                     
   51                     
   52                     
   53                     ;----------------
   54                     ; システム関連
   55                     ;----------------
   56           00B0      FLG_2000        EQU     $B0
   57           00B1      FLG_2001        EQU     $B1
   58                     ;BG_SCR_Y       EQU     $B2
   59                     
   60           00B3      NMI_FLG         EQU     $B3
   61                     
   62                     
   63                     
   64           0400      PICO_DATA_BUF  EQU      $400    ; PICO のデータ読み込みバッファ
   65           0400      FLASH_DEBUG_BUF  EQU    $400    ; FLASHデバッグ用バッファ
   66           0400      FLASH_SAVE_BUF   EQU    $400    ; FLASHセーブ用バッファ
   67                     
   68           0500      FLASH_EXEC_BUF  EQU     $500    ; FLASHアクセスコード実行バッファ
   69                     
   70                     
   71                     
   72                     ;----------------
   73                     ; PPU
   74                     ;----------------
   75                     ; MMC3のIRQを使う場合は BG を$0000番地, Spr を$1000番地に配置しなければならない
   76           0088      FLG_PPU2000     EQU     %100_01_0_00
   77                                                     ; NMI gen,master,SP8x8,BG$0000,SP$0000,+1,v0,h0
   78                     
   79                     
   80           001E      FLG_PPU2001     EQU     %000_11_11_0
   81                     
   82                     
   83                     ;----------------
   84                     ; KEY BIT CODE
   85                     ;----------------
   86           0080      KEY_A           EQU     $80
   87           0040      KEY_B           EQU     $40
   88           0020      KEY_SEL         EQU     $20
   89           0010      KEY_RUN         EQU     $10
   90           0008      KEY_UP          EQU     $08
   91           0004      KEY_DOWN        EQU     $04
   92           0002      KEY_LEFT        EQU     $02
   93           0001      KEY_RIGHT       EQU     $01
   94                     
   95           00C0      KEY_AB          EQU     $C0
   96           00F0      KEY_ABRS        EQU     $F0
   97                     
   98                     
   99                     ;----------------
  100                     ; キーリピート設定
  101                     ;----------------
  102           0018      REP_WAIT        EQU     24      ; リピート開始までの時間 (フレーム数)
  103           0008      REP_INTERVAL    EQU      8      ; リピート間隔 (フレーム数)
