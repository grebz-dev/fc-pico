   21                     ;
   22                     ; ファミコンからPICO　コマンド
   23                     ;
   24                     ;----------------------------------------------
   25           000F      FP_COM_ACK      = $0F           ; PICOからのコマンド正常終了応答
   26           001F      FP_COM_NAK      = $1F           ; PICOからのコマンド失敗終了応答
   27           002F      FP_COM_VER      = $2F           ; BIOS-ROMのバージョン取得：0x0FバイトのROMバージョン文字列
   28           003F      FP_COM_ROM      = $3F           ; BIOS-ROMのROMデータ要求コマンド： FP_COM_ROM,アドレスH : 0x100分のROMデータ読み出す
   29                     
   30           00BF      FP_COM_LOG      = $BF           ; ログ
   31           00CF      FP_COM_DRQ      = $CF           ; データリクエスト
   32           00DF      FP_COM_DLD      = $DF           ; データロード
   33           00EF      FP_COM_RST      = $EF           ; PICOリスタート
   34           00FF      FP_COM_INI      = $FF           ; PICO初期化
