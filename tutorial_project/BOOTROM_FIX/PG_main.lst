#[2]   SysKey.asm
  104                             .INCLUDE        "SysKey.asm"
    1                     ;========================================
    2                     ; Key System
    3                     ;========================================
    4                     
    5                     ;*****************************************
    6                     ;キー入力システム
    7                     ;*****************************************
    8                     ;       拡張ＰＡＤ対応および、ΔＰＣＭ再生によるノイズ除去処理を追加しました。
    9                     ;
   10                     ;                                                               渡部
   11                     ;****************
   12                     ; KEY RTN       *
   13                     ;****************
   14                     ;
   15  03:F00F            BR_KEY_RTN:
   16                             ;----------------------------------------------------------------------
   17                             ; 4 回読込み版
   18                             ;----------------------------------------------------------------------
   19  03:F00F  A5 85             lda     <KEY_NEW
   20  03:F011  85 84             sta     <KEY_OLD
   21                     
   22  03:F013  20 6A F0           jsr    .read                   ; 6+153
   23  03:F016  85 0C              sta    <KEY_CH1                ; 3
   24  03:F018  20 6A F0           jsr    .read                   ; 6+153
   25  03:F01B  48                 pha                            ; 3
   26  03:F01C  20 6A F0            jsr   .read                   ; 6+153
   27  03:F01F  85 0D               sta   <KEY_CH3                ; 3
   28  03:F021  20 6A F0            jsr   .read                   ; 6+153  (645)
   29  03:F024  68                 pla                            ; (2nd read)
   30  03:F025  C5 0C             cmp     <KEY_CH1
   31  03:F027  F0 06             beq     .store                  ; XX--
   32  03:F029  C5 85             cmp     <KEY_NEW                ; (4th read)
   33  03:F02B  F0 02             beq     .store                  ; -X-X
   34  03:F02D  A5 0D             lda     <KEY_CH3                ; X-X-
   35                                                             ; -XX-
   36                                                             ; --XX
   37  03:F02F            .store:
   38  03:F02F  85 85             sta     <KEY_NEW
   39                     
   40                     ;;      lda     <KEY_NEW
   41  03:F031  45 84             eor     <KEY_OLD
   42  03:F033  48                pha
   43  03:F034  25 85              and    <KEY_NEW
   44  03:F036  85 83              sta    <KEY_TRG
   45  03:F038  68                pla
   46  03:F039  25 84             and     <KEY_OLD
   47  03:F03B  85 82             sta     <KEY_REL
   48                     
   49                     ;;      RTS
   50                     
   51                             ;--v--v-- キーリピートを追加 (2016-05-21 門真)
   52  03:F03D  A5 83             lda     <KEY_TRG
   53  03:F03F  29 0F             and     #(KEY_UP|KEY_DOWN|KEY_LEFT|KEY_RIGHT)
   54  03:F041  F0 0C             beq     .main                   ; 新たに押されたキーがない?
   55                     
   56  03:F043  A8                tay
   57  03:F044  B9 84 F0          lda  ro_keytable, y             ; 同時押し対策 (下上右左の順に優先)
   58  03:F047  85 8A             sta     <REP_KEY                ; 新たに押されたキーをリピート用に設定
   59  03:F049  A9 18             lda     #REP_WAIT
   60  03:F04B  85 8C             sta     <REP_CNT                ; 初回ウェイト
   61           0001              .if     1
   62           0018               .if     REP_WAIT
   63  03:F04D  D0 16               bne   .press                  ; =bra  押し始めは押下あり
   64                              .else
   66                              .endif
   67                             .else
   70                             .endif
   71  03:F04F            .main:
   72  03:F04F  A5 85             lda     <KEY_NEW
   73  03:F051  25 8A             and     <REP_KEY
   74  03:F053  F0 12             beq     .set                    ; リピート用キーが押されていない (a=0)?
   75                     
   76  03:F055  C6 8C             dec     <REP_CNT                ; ウェイトのカウントダウン
   77  03:F057  F0 0C             beq     .press                  ; 初回ウェイト終了か?
   78  03:F059  A5 8C             lda     <REP_CNT
   79  03:F05B  49 F8             eor     #-REP_INTERVAL
   80  03:F05D  C9 01             cmp     #1                      ; c = 0:一致 / 1:不一致
   81  03:F05F  A9 00             lda     #0                      ; カウンタ初期値 または 押下キーなし
   82  03:F061  B0 04             bcs     .set                    ; 2 回目以降のウェイト終了でないか?
   83                     
   84  03:F063  85 8C             sta     <REP_CNT                ; カウンタを戻す。
   85  03:F065            .press:
   86  03:F065  A5 8A             lda     <REP_KEY
   87  03:F067            .set:
