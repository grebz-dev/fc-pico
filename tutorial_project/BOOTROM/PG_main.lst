  418                     ;------------------------------------------------------------------------------
  419                     ;                               文字列描画
  420                     ;                               \1 = 文字列
  421                     ;------------------------------------------------------------------------------
  422                     DRAW_STRING2 MACRO
  423                             LDA  #HIGH (.end\@ -1)
  424                             PHA
  425                             LDA  #LOW (.end\@ -1)
  426                             PHA
  427                             LDA  #LOW (.tbl\@ )
  428                             STA  <SRC_ADR
  429                             LDA  #HIGH (.tbl\@ )
  430                             jmp  DRAW_STRING_SUB
  431                     .tbl\@:
  432                         db  \1,0
  433                     .end\@:
  434                             ENDM
