  729                     ;-------------------------------------------------------------------------------
  730                     ; メモリー制御
  731                     ;-------------------------------------------------------------------------------
  732                     
  733                     ;   A reg クリアーデータ
  734                     ;   Y reg クリアーサイズ ( 0 は 256バイト )
  735                     ;       \1 = クリアーメモリーアドレス (16bit adr)
  736                     
  737                     CLEAR_MEM       macro
  738                     
  739                     .loop\@:
  740                             dey
  741                             sta   \1,Y
  742                             bne   .loop\@
  743                     
  744                                     endm
  745                     
  746                     
  747                     COPY_TBL        macro
  748                             ldx  #0
  749                     .loop\@:
  750                             lda  \1,x
  751                             sta  \2,x
  752                             inx
  753                             cpx  #\3
  754                             bne   .loop\@
  755                                     endm
  756                     
  757                     
  758                     ;       \1 = 転送元アドレス (BNK+16bit adr)
  759                     ;       \2 = 転送先アドレス (16bit adr)
  760                     ;       \3 = 転送サイズ (8bit)
  761                     
  762                     COPY_MEM        macro
  763                             lda  #LOW (\1)
  764                             sta  <SRC_ADR
  765                             lda  #HIGH (\1)
  766                         sta  <SRC_ADR+1
  767                     
  768                             lda  #LOW (\2)
  769                             sta  <DST_ADR
  770                             lda  #HIGH (\2)
  771                         sta  <DST_ADR+1
  772                     
  773                             ldy  #(\3)
  774                             jsr  memcpy
  775                     
  776                             endm
  777                     
  778                     ;       \1 = 転送元アドレス (BNK+16bit adr)
  779                     ;       \2 = 転送先アドレス (16bit adr)
  780                     ;       \3 = 転送サイズ (16bit)
  781                     
  782                     COPY_MEM16      macro
  783                             lda  #LOW (\1)
  784                             sta  <SRC_ADR
  785                             lda  #HIGH (\1)
  786                         sta  <SRC_ADR+1
  787                     
  788                             lda  #LOW (\2)
  789                             sta  <DST_ADR
  790                             lda  #HIGH (\2)
  791                         sta  <DST_ADR+1
  792                     
  793                             ldy  #LOW (\3)
  794                             ldx  #HIGH (\3)
  795                     
  796                             lda  #BANK (\1) /2
  797                     
  798                             jsr  memcpy_x
  799                     
  800                             endm
