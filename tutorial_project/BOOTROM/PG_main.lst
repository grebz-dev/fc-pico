  514                     ;------------------------------------------------------------------------------
  515                     ;                               テーブルジャンプ
  516                     ;                               A reg = ジャンプ先テーブル番号
  517                     ;------------------------------------------------------------------------------
  518                     TBL_JUMP        MACRO
  519                             ASL     A
  520                             stx  <TMP_SYS
  521                             TAX
  522                             LDA     .tbl\@+1,X
  523                             PHA
  524                             LDA     .tbl\@+0,X
  525                             ldx  <TMP_SYS
  526                             PHA
  527                             RTS
  528                     .tbl\@:
  529                             ENDM
