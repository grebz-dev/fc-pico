#[1]   PG_main.asm
#[2]   macro.h
   25                             .INCLUDE        "macro.h"
    1                     ;******************************************************************************
    2                     ;       MOVE関係
    3                     ;******************************************************************************
    4                     LD_W MACRO
    5                             lda  \2
    6                             sta  \1
    7                             lda  \2+1
    8                             sta  \1+1
    9                             ENDM
   10                     
   11                     ;******************************************************************************
   12                     ;       算術関係
   13                     ;******************************************************************************
   14                     
   15                     ADD_W MACRO
   16                             clc
   17                             lda  \1
   18                             adc  \2
   19                             sta  \1
   20                             lda  \1+1
   21                             adc  \2+1
   22                             sta  \1+1
   23                             ENDM
   24                     
   25                     ;------------------------------------------------------------------------------
   26                     ;                               バイト足し演算
   27                     ;------------------------------------------------------------------------------
   28                     add     MACRO
   29                             clc
   30                             adc     \1
   31                             ENDM
   32                     ;------------------------------------------------------------------------------
   33                     ;                               バイト引き演算
   34                     ;------------------------------------------------------------------------------
   35                     sub     MACRO
   36                             sec
   37                             sbc     \1
   38                             ENDM
   39                     ;------------------------------------------------------------------------------
   40                     ;                               ワード足し演算
   41                     ;                               xy + \1\2 = xy
   42                     ;------------------------------------------------------------------------------
   43                     addw    MACRO
   44                             pha
   45                     
   46                             tya
   47                             add     \2
   48                             tay
   49                             bne     .byte_over\@
   50                             bcc     .byte_over\@
   51                     
   52                             sec
   53                     .byte_over\@:
   54                             txa
   55                             adc     \1
   56                             tax
   57                     
   58                             pla
   59                             ENDM
   60                     ;------------------------------------------------------------------------------
   61                     ;                               ワード引き演算
   62                     ;                               xy - \1\2 = xy
   63                     ;------------------------------------------------------------------------------
   64                     subw    MACRO
   65                             pha
   66                     
   67                             tya
   68                             sub     \2
   69                             tay
   70                     
   71                             txa
   72                             sbc     \1
   73                             tax
   74                     
   75                             pla
   76                             ENDM
   77                     
   78                     ;------------------------------------------------------------------------------
   79                     ;                               ワードインクリメント
   80                     ;                               \1\2 + 1 = \1\2
   81                     ;------------------------------------------------------------------------------
   82                     incw    MACRO
   83                             inc     \1
   84                             bne     .iend\@
   85                     
   86                             inc     \1 + 1
   87                     .iend\@:
   88                     
   89                             ENDM
   90                     
   91                     ;------------------------------------------------------------------------------
   92                     ;                               ワードデクリメント
   93                     ;                               \1\2 - 1 = \1\2
   94                     ;------------------------------------------------------------------------------
   95                     decw    MACRO
   96                             lda     \1
   97                             bne     .dend\@
   98                     
   99                             dec     \1 + 1
  100                     .dend\@:
  101                             dec     \1
  102                     
  103                             ENDM
  104                     
  105                     ;------------------------------------------------------------------------------
  106                     ;               擬似ワードレジスタ　AR に固定ワードセット
  107                     ;------------------------------------------------------------------------------
  108                     SET_AR  MACRO
  109                             LDA     \1 & $ff
  110                             STA     <W_AR
  111                             LDA     \1 >> 8
  112                             STA     <W_AR+1
  113                             ENDM
  114                     
  115                     ;------------------------------------------------------------------------------
  116                     ;               擬似ワードレジスタ　BR に固定ワードセット
  117                     ;------------------------------------------------------------------------------
  118                     SET_BR  MACRO
  119                             LDA     \1 & $ff
  120                             STA     <W_BR
  121                             LDA     \1 >> 8
  122                             STA     <W_BR+1
  123                             ENDM
  124                     
  125                     ;------------------------------------------------------------------------------
  126                     ;               擬似ワードレジスタ　AR にメモリー上のワード値セット
  127                     ;------------------------------------------------------------------------------
  128                     SET_AR_M        MACRO
  129                             LDA     \1
  130                             STA     <W_AR
  131                             LDA     \1+1
  132                             STA     <W_AR+1
  133                             ENDM
  134                     
  135                     ;------------------------------------------------------------------------------
  136                     ;               擬似ワードレジスタ　BR にメモリー上のワード値セット
  137                     ;------------------------------------------------------------------------------
  138                     SET_BR_M        MACRO
  139                             LDA     \1
  140                             STA     <W_BR
  141                             LDA     \1+1
  142                             STA     <W_BR+1
  143                             ENDM
  144                     
  145                     ;------------------------------------------------------------------------------
  146                     ;                               対象のメモリーのビットをセットする
  147                     ;                               対象メモリーアドレス = \1
  148                     ;                               セットするビット     = \2
  149                     ;------------------------------------------------------------------------------
  150                     SET_BIT         MACRO
  151                             LDA     \1
  152                             ORA     \2
  153                             STA     \1
  154                             ENDM
  155                     
  156                     ;------------------------------------------------------------------------------
  157                     ;                               対象のメモリーのビットをクリアーする
  158                     ;                               対象メモリーアドレス = \1
  159                     ;                               クリアーするビット   = \2
  160                     ;------------------------------------------------------------------------------
  161                     CLR_BIT         MACRO
  162                             LDA     \1
  163                             AND     $ff - \2
  164                             STA     \1
  165                             ENDM
  166                     
  167                     ;------------------------------------------------------------------------------
  168                     ;                               対象のメモリーのビットをチェックする
  169                     ;                               対象メモリーアドレス = \1
  170                     ;                               チェックするビット   = \2
  171                     ;------------------------------------------------------------------------------
  172                     CHK_BIT         MACRO
  173                             LDA     \1
  174                             AND     \2
  175                             ENDM
  176                     
  177                     
  178                     ;------------------------------------------------------------------------------
  179                     ;                               XYレジスタをスタックに退避
  180                     ;------------------------------------------------------------------------------
  181                     phxy            MACRO
  182                             sta  <TMP_SYS
  183                             txa
  184                             pha
  185                             tya
  186                             pha
  187                             lda  <TMP_SYS
  188                             ENDM
  189                     
  190                     ;------------------------------------------------------------------------------
  191                     ;                               XYレジスタをスタックから復帰
  192                     ;------------------------------------------------------------------------------
  193                     plxy            MACRO
  194                             sta  <TMP_SYS
  195                             pla
  196                             tay
  197                             pla
  198                             tax
  199                             lda  <TMP_SYS
  200                             ENDM
  201                     
  202                     ;------------------------------------------------------------------------------
  203                     ;                               SRC_ADRをスタックに退避
  204                     ;------------------------------------------------------------------------------
  205                     phSRC_ADR       MACRO
  206                             lda  <SRC_ADR+0
  207                             pha
  208                             lda  <SRC_ADR+1
  209                             pha
  210                             ENDM
  211                     
  212                     ;------------------------------------------------------------------------------
  213                     ;                               XYレジスタをスタックから復帰
  214                     ;------------------------------------------------------------------------------
  215                     plSRC_ADR       MACRO
  216                             pla
  217                             sta  <SRC_ADR+1
  218                             pla
  219                             sta  <SRC_ADR+0
  220                             ENDM
  221                     
  222                     ;******************************************************************************
  223                     ;       表示関係
  224                     ;******************************************************************************
  225                     ;       画面切り替え時にＩＲＱ割り込みラインでのノイズを対処すべく、
  226                     ;       表示on、表示offは、マクロ化しました。→DISP_ON, DISP_OFF
  227                     ;       それに伴い、NMI_FLGの操作も併せて、こちらに移動しました。
  228                     ;                                                       渡部
  229                     ;------------------------------------------------------------------------------
  230                     ;                               表示on
  231                     ;------------------------------------------------------------------------------
  232                     DISP_ON         MACRO
  233                             jsr  _disp_on_sub
  234                             ENDM
  235                     
  236                     ;------------------------------------------------------------------------------
  237                     ;                               表示on NO SP
  238                     ;------------------------------------------------------------------------------
  239                     DISP_ON_NSP             MACRO
  240                             jsr  _disp_on_sub2
  241                             ENDM
  242                     
  243                     ;------------------------------------------------------------------------------
  244                     ;                               表示off
  245                     ;------------------------------------------------------------------------------
  246                     DISP_OFF        MACRO
  247                             jsr  _disp_off_sub
  248                             ENDM
  249                     
  250                     ;------------------------------------------------------------------------------
  251                     ;                               VRAMアドレスセット
  252                     ;                               VRAMアドレス = \1(16bit adr)
  253                     ;------------------------------------------------------------------------------
  254                     SET_VRAM_ADD2   MACRO
  255                             lda #HIGH (\1)
  256                         sta $2006
  257                             lda #LOW  (\1)
  258                             sta $2006
  259                             ENDM
  260                     
  261                     ;------------------------------------------------------------------------------
  262                     ;                               VRAMアドレスセット
  263                     ;                               VRAMアドレス = \1(16bit adr)
  264                     ;                               加算値 = \2
  265                     ;------------------------------------------------------------------------------
  266                     SET_VRAM_ADD3   MACRO
  267                             clc
  268                             lda #LOW  (\1)
  269                             adc  \2
  270                             pha
  271                             lda #HIGH (\1)
  272                             adc #0
  273                         sta $2006
  274                             pla
  275                             sta $2006
  276                             ENDM
  277                     
  278                     ;------------------------------------------------------------------------------
  279                     ;                               VRAMアドレスセット
  280                     ;                               VRAMアドレス = \1(16bit adr)
  281                     ;                               加算値 = \2
  282                     ;------------------------------------------------------------------------------
  283                     SET_VRAM_ADD4   MACRO
  284                             clc
  285                             lda #LOW  (\1)
  286                             adc  \2
  287                             pha
  288                             lda #HIGH (\1)
  289                             adc \2 +1
  290                         sta $2006
  291                             pla
  292                             sta $2006
  293                             ENDM
  294                     
  295                     ;------------------------------------------------------------------------------
  296                     ;                               VRAMアドレスセット
  297                     ;                               VRAMアドレス = \1(16bit adr)
  298                     ;------------------------------------------------------------------------------
  299                     SET_VRAM_LOC    MACRO
  300                             lda #HIGH (\1)
  301                         sta <TMP_ADR0+1
  302                             lda #LOW  (\1)
  303                         sta <TMP_ADR0+0
  304                             ENDM
  305                     
