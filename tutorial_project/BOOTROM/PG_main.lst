  531                     ;------------------------------------------------------------------------------
  532                     ;  テーブルジャンプ先　宣言用マクロ　スタックを使う場合ジャンプ先-1 をプッシュ
  533                     ;------------------------------------------------------------------------------
  534                     JPTBL   MACRO
  535                             DW      \1 -1
  536                             ENDM
  537                     
  538                     ;------------------------------------------------------------------------------
  539                     ;                               バンク付テーブルジャンプ
  540                     ;                               A reg = ジャンプ先テーブル番号
  541                     ;------------------------------------------------------------------------------
  542                     BNK_TBL_JUMP    MACRO
  543                             sta  <TMP_SYS
  544                             stx  <TMP_SYS2
  545                             asl a
  546                             clc
  547                             adc  <TMP_SYS
  548                             tax
  549                     
  550                             ; 各ミッションタイプに応じた初期化処理を呼び出し
  551                             lda  .tbl\@+1,x
  552                             pha
  553                             lda  .tbl\@+0,x
  554                             pha
  555                     
  556                             lda  .tbl\@+2,x         ;BANK
  557                             jsr  SYS_CHG_BANK
  558                             ldx  <TMP_SYS2
  559                             rts
  560                     .tbl\@:
  561                             ENDM
