/// @file env_set0.mmh
/// @brief Envelope definitions and drum macros shared by every track.
/// @ingroup toolchain
///
/// Defines voice (`E@`), volume (`Ev`), frequency (`Em`) and note (`En`)
/// envelopes, plus the noise-channel drum macros `$k`, `$h` and `$s` and the
/// triangle-channel drum trick `$pn`.
///
/// @note The frequency envelope originally used full-width braces; they were
///       normalised to ASCII when the tree moved to UTF-8, and the rebuilt NSF is
///       byte-identical. @see @ref conventions
// ENV定義
/*
        E@voice_envelope
        Evvolume_envelope
        Emfrequency_envelope
        Ennote_envelope



*/


//==============================================================================
//	 Voice(E@)	音色エンペローブ
//==============================================================================
E(1001){ 3 3 L 2 }
E(1002){ L 1 2 0 }

//==============================================================================
//	 Volume(Ev)	音量エンペローブ
//==============================================================================


// 音量推移パターン
E(2000){ 15 D10 14 13 12  L 11 11 10 10 9 9 10 10 R 9 8 7 6 5 L 4 4 3 3 2 2 3 3 }

//==============================================================================
//	 Frequency(Em)	周波数エンペローブ
//==============================================================================

E(3000){ 0 D12 L 1 2 3 2 1 0 -1 -2 -3 -2 -1 0 }

//==============================================================================
//	 Note(En)	ノートエンペローブ
//==============================================================================
Envelop(4000){ L 0 -5 0 }


//==============================================================================
// ノイズドラム
//==============================================================================
//vol
E(6001) = {7 4 2 1 L 0}
E(6005) = {12 9 7 6 5 4 3 3 2 2 L 1}

//note
E(6101) = {11 L 13}
E(6105) = {-10 4 6 7 8 L 9}


/// @brief Kick drum: selects the kick volume and note envelopes.
/// @ingroup toolchain
$k{ Ev6000 En6100 }

/// @brief Hi-hat: selects the hi-hat volume and note envelopes.
/// @ingroup toolchain
$h{ Ev6001 En6101 }		// hh
/// @brief Snare: selects the snare volume and note envelopes.
/// @ingroup toolchain
$s{ Ev6005 En6105 }


//==============================================================================
// 三角波ドラム
//==============================================================================

/// @brief Triangle-channel percussion click.
/// @details Pulses `$4011` high then low, which produces a click from the DMC
///          channel without playing a sample.
/// @ingroup toolchain
$pn{  y$4011,$1f y$4011,$00 }

// バスドラムＯＮ
/// @brief Kick drum: selects the kick volume and note envelopes.
/// @ingroup toolchain
$kon{ $pn }
// スネアドラムＯＮ
/// @brief Snare: selects the snare volume and note envelopes.
/// @ingroup toolchain
$son{ $pn }
// ドラムＯＦＦ
/// @brief Drum off: clears the note and frequency envelopes.
/// @ingroup toolchain
$dof{ En* Em* }

/// @brief Tom, high: octave 5 with the tom frequency envelope.
/// @ingroup toolchain
$thon{ En* o5 q6 Em6200  }
/// @brief Tom, mid: octave 4 with the tom frequency envelope.
/// @ingroup toolchain
$tmon{ En* o4 q6 Em6200  }
/// @brief Tom, low: octave 3 with the tom frequency envelope.
/// @ingroup toolchain
$tlon{ En* o3 q6 Em6200  }




;Sub(0){
;	subroutine sequence
;}

#timebase 24 ;@t4,24

